# API Base URL for LearnPath AI Backend Server
# -------------------------------------------------------------
# 1. PRODUCTION (Render Free Web Service):
# EXPO_PUBLIC_API_URL=https://ai-learning-path-backend.onrender.com
#
# 2. LOCAL ANDROID EMULATOR (points to host computer loopback):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
#
# 3. LOCAL PHYSICAL ANDROID PHONE (replace with your laptop's local Wi-Fi IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
#
# 4. DEFAULT DEVELOPMENT:
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_APP_ENV=development

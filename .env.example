# 1. DATABASE (Supabase PostgreSQL Connection Pooler)
DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DB_USER=postgres.munzcpabkjiuxorgmrse
DB_PASSWORD=your_supabase_db_password_here

# 2. SUPABASE DIRECT CREDENTIALS (For Client & RLS Integration)
SUPABASE_URL=https://munzcpabkjiuxorgmrse.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 3. AI SERVICES (Google Gemini)
GEMINI_API_KEY=your_google_gemini_api_key_here

# 4. EMAIL SERVICE FOR OTP (Brevo / Resend / Google Apps Script)
RESEND_API_KEY=your_resend_api_key_here
BREVO_API_KEY=your_brevo_api_key_here
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_smtp_login
MAIL_PASSWORD=your_brevo_smtp_key

# 5. GOOGLE OAUTH
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# 6. APPLICATION & SECURITY
SERVER_PORT=5000
JWT_SECRET=your_256_bit_secure_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# 7. FRONTEND API CONFIGURATION
API_BASE_URL=https://ai-learning-backend-ztk7.onrender.com

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Brevo (Sendinblue) Email API Configuration
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@siddhartha.ac.in
BREVO_SENDER_NAME="AI Learning Path Generator"

# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Security & JWT Configuration
JWT_SECRET_KEY=change-this-to-a-super-secret-random-key-with-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=5

# Domain & Access Control Configuration
FACULTY_ALLOWED_DOMAINS=["@siddhartha.ac.in"]
FACULTY_SPECIAL_EMAILS=["vivekvaranasi99@gmail.com"]
STUDENT_INSTITUTIONAL_DOMAIN=@vrsec.ac.in

# Server & CORS Configuration
CORS_ORIGINS=["*"]
ENVIRONMENT=development
PORT=8000
